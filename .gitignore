# NammaMart ETL & ELT: standalone Astro project

# ---- Never commit ----
# Astro CLI local state
.astro/config.yaml.lock
.astro/*.local.yml
.astro/*.local.yaml
.astro/standalone/
.astro/worktrees/
astro
.venv
airflow.db
airflow.cfg
webserver_config.py
logs/
# Warehouse files and run scratch space (rebuilt by the DAGs)
include/warehouse_*.duckdb
include/warehouse_*.duckdb.wal
include/tmp/
# Quarantine files hold rows exactly as received, including unmasked customer PII
include/quarantine/
# Local secrets
.env
# Python and OS clutter
__pycache__/
*.py[cod]
.DS_Store

